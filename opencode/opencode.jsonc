{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "enabled_providers": [
    "llamabarn"
  ],
  "provider": {
    "llamabarn": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LlamaBarn",
      "options": {
        "baseURL": "http://127.0.0.1:2276/v1",
      },
      "models": {
        "mudler/Qwen3.6-35B-A3B-APEX-GGUF:unknown": {
          "name": "Qwen 3.6 35B-A3B",
          "limit": {
            "context": 131072,
            "output": 16384,
          },
          "variants": {
            "high": {
              "reasoningEffort": "high",
            },
            "low": {
              "reasoningEffort": "low",
            },
          },
        },
        "qwen-3.5-small-0.8b": {
          "name": "Qwen 3.5 Small 0.8B",
          "limit": {
            "context": 262144,
            "output": 16384,
          },
        },
        "gemma-4-e4b": {
          "name": "Gemma 4 E4B",
          "limit": {
            "context": 131072,
            "output": 16384,
          },
        },
        "gemma-4-26b-a4b": {
          "name": "Gemma 4 26B-A4B",
          "limit": {
            "context": 16384,
            "output": 2048,
          },
        },
        "gemma-4-31b-q4": {
          "name": "Gemma 4 31B",
          "limit": {
            "context": 32768,
            "output": 8192,
          },
        },
      },
    },
  },
  "lsp": false,
  "share": "disabled",
  "permission": {
    "webfetch": "deny",
    "websearch": "deny",
    "todowrite": "deny",
    "edit": "ask",
    "bash": "ask",
    "external_directory": "ask",
  },
  "agent": {
    "build": {
      "disable": true,
    },
    "chat": {
      "mode": "primary",
      "description": "A regular chatbot",
      "permission": {
        "*": "deny"
      }
    },
  },
  "default_agent": "chat",
}
